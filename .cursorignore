# Cursor: exclude from indexing / AI context (keeps chat fast, avoids noise + secrets)

# Dependencies (large; source lives in package.json / requirements.txt)
node_modules/

# Python
.venv/
venv/
**/.venv/
**/venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Secrets and local env
*.env
.env.*
!.env.example

# ML / large binaries (same as .gitignore intent)
# Eva_AI_Server/models/
# */testModels/*

# Data & generated test artifacts
# DataSets/
# Roadmaps/
EVA_Test_Automation/
Frontend/
testingPoints.txt
EVA_Task_Test_Data_HAMID.txt

# Logs and OS junk
*.log
logs/
.DS_Store
Thumbs.db

# Editor / tooling (optional local state)
.vscode/

# Build / coverage (if added later)
dist/
build/
coverage/
.nyc_output/
