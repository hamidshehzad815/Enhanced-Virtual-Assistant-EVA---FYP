{
  "intent": "learning_create",
  "version": "1.0.0",
  "note": "Entity-order and phrasing variants for learning NER.",
  "groups": [
    {
      "id": "compact_order",
      "label": "Compact date/duration order",
      "templates": [
        {
          "text": "learn {topic} {subtopic} starting {start_date} for {duration}",
          "entities": ["topic", "subtopic", "start_date", "duration"],
          "intent": "learning_create"
        },
        {
          "text": "create {topic} {subtopic} plan {start_date} {duration}",
          "entities": ["topic", "subtopic", "start_date", "duration"],
          "intent": "learning_create"
        },
        {
          "text": "learn {topic} starting {start_date} for {duration}",
          "entities": ["topic", "start_date", "duration"],
          "intent": "learning_create"
        },
        {
          "text": "I need to learning {topic} for {duration}",
          "entities": ["topic", "duration"],
          "intent": "learning_create"
        },
        {
          "text": "create {topic} {subtopic} plan starting {start_date} for {duration}",
          "entities": ["topic", "subtopic", "start_date", "duration"],
          "intent": "learning_create"
        }
      ]
    },
    {
      "id": "person_variants",
      "label": "Person in learning commands",
      "templates": [
        {
          "text": "learn {topic} with {person} for {duration}",
          "entities": ["topic", "person", "duration"],
          "intent": "learning_create"
        },
        {
          "text": "create {topic} roadmap with {person} starting {start_date}",
          "entities": ["topic", "person", "start_date"],
          "intent": "learning_create"
        },
        {
          "text": "study {topic} {subtopic} with {person}",
          "entities": ["topic", "subtopic", "person"],
          "intent": "learning_create"
        },
        {
          "text": "learn {topic} with {person} starting {start_date}",
          "entities": ["topic", "person", "start_date"],
          "intent": "learning_create"
        }
      ]
    },
    {
      "id": "shuffled_order",
      "label": "Shuffled entity order",
      "templates": [
        {
          "text": "for {duration} learn {topic} {subtopic}",
          "entities": ["topic", "subtopic", "duration"],
          "intent": "learning_create"
        },
        {
          "text": "starting {start_date} learn {topic}",
          "entities": ["topic", "start_date"],
          "intent": "learning_create"
        },
        {
          "text": "{topic} {subtopic} roadmap for {duration}",
          "entities": ["topic", "subtopic", "duration"],
          "intent": "learning_create"
        },
        {
          "text": "{topic} {subtopic} plan starting {start_date}",
          "entities": ["topic", "subtopic", "start_date"],
          "intent": "learning_create"
        }
      ]
    },
    {
      "id": "conversational",
      "label": "Conversational phrasing",
      "templates": [
        {
          "text": "I want to learn {topic} {subtopic}",
          "entities": ["topic", "subtopic"],
          "intent": "learning_create"
        },
        {
          "text": "help me learn {topic} from scratch",
          "entities": ["topic"],
          "intent": "learning_create"
        },
        {
          "text": "teach me {topic} {subtopic}",
          "entities": ["topic", "subtopic"],
          "intent": "learning_create"
        },
        {
          "text": "make a {topic} study plan for {duration}",
          "entities": ["topic", "duration"],
          "intent": "learning_create"
        }
      ]
    },
    {
      "id": "update_delete_order",
      "label": "Update/delete order variants",
      "templates": [
        {
          "text": "pause {topic} {subtopic} roadmap",
          "entities": ["topic", "subtopic"],
          "intent": "learning_update"
        },
        {
          "text": "delete {topic} {subtopic} plan",
          "entities": ["topic", "subtopic"],
          "intent": "learning_delete"
        },
        {
          "text": "remove {topic} roadmap starting {start_date}",
          "entities": ["topic", "start_date"],
          "intent": "learning_delete"
        },
        {
          "text": "update {topic} plan to {duration}",
          "entities": ["topic", "duration"],
          "intent": "learning_update"
        },
        {
          "text": "shift {topic} {subtopic} to {start_date}",
          "entities": ["topic", "subtopic", "start_date"],
          "intent": "learning_update"
        }
      ]
    }
  ]
}
