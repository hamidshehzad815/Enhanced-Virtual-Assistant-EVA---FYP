    "new_scheduled_date": "new_date",
    "new_start_date": "new_date",
    "subject": "task_name"
  },
  "learning_entity_aliases": {
    "subject": "topic",
    "date_to_start_date_on_create": {
      "intent": "learning_create",
      "from": "date",
      "to": "start_date"
    },
    "person_on_create": {
      "intent": "learning_create",
      "keep_as": "person"
    }
  },
  "required_entities": {
    "scheduling_add": {
      "required": ["task_name", "date", "time"],
      "optional": ["priority", "duration", "collaborator"]
    },
    "scheduling_delete": {
      "required": [],
      "optional": ["task_name", "date", "priority", "status"],
      "note": "At least one filter entity must be present"
    },
    "scheduling_update": {
      "required": ["task_name"],
      "optional": ["date", "priority", "status", "new_title", "new_date", "new_time", "new_priority", "new_status", "new_duration"],
      "note": "At least one new_* field required in practice"
    },
    "scheduling_show": {
      "required": [],
      "optional": ["date", "priority", "status", "task_name"]
    },
    "behavioral": {
      "required": ["day"],
      "optional": []
    },
    "learning_create": {
      "required": ["topic"],
      "optional": ["subtopic", "start_date", "duration", "person"]
    },
    "learning_update": {
      "required": ["topic"],
      "optional": ["subtopic", "date"]
    },
    "learning_delete": {
      "required": ["topic"],
      "optional": ["subtopic"]
    }
